# QwikMart website — Firebase only (docs/FIREBASE_BACKEND.md). No REST API.

# true = in-browser demo data (src/lib/mock), no Firebase at all.
# (The demo data is also used automatically when the Firebase web config below is missing.)
NEXT_PUBLIC_USE_MOCK=false

# Firebase web app config (Firebase console → Project settings → Your apps → Web) — project qwikmart-37299
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=qwikmart-37299
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=qwikmart-37299.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: Web Push certificate key (Cloud Messaging → Web configuration). Empty = no FCM web push.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Local Firebase Emulator Suite (cd ../firebase && npx firebase emulators:start --project qwikmart-37299 --import tools/emulator-data)
NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_FUNCTIONS_EMULATOR_PORT=5001
NEXT_PUBLIC_STORAGE_EMULATOR_PORT=9199

# Public site URL — used for absolute share-image (Open Graph) links. Set to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
