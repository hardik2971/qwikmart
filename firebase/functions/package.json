{
  "name": "qwikmart-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:run": "vitest run",
    "serve": "npm run build && node scripts/run-tests.mjs --serve"
  },
  "dependencies": {
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.4.0",
    "nodemailer": "10.0.10",
    "pdfkit": "0.20.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.3",
    "@types/nodemailer": "7.0.12",
    "@types/pdfkit": "0.17.6",
    "firebase": "12.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
