# Deploy-time params for project qwikmart-infidec (read by `firebase deploy`; the emulator uses .env.local).
# HOT_MIN_INSTANCES: warm instances for detectZone / getHome / cartSummary (1 avoids cold starts, ~costs one idle instance each).
# ENFORCE_APP_CHECK: true once every client sends App Check tokens.
HOT_MIN_INSTANCES=1
ENFORCE_APP_CHECK=false
# WEBSITE_URL: customer website used for links in order emails.
WEBSITE_URL=https://qwikmart-infidec.web.app
